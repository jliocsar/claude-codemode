{
  "name": "claude-codemode",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "test ! -e .git || git config core.hooksPath .githooks",
    "lint": "oxlint --type-aware --deny-warnings --disable-nested-config",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings --disable-nested-config",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "typecheck": "tsc -p . --noEmit && tsc -p codemode --noEmit",
    "test": "claude plugin test . && cd codemode && bun test ./server.spec.ts"
  },
  "devDependencies": {
    "@jliocsar/begone-slop": "^0.2.12",
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
