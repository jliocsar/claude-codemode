{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@jliocsar/begone-slop/preset.json"],
  "plugins": ["typescript", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error"
  },
  "ignorePatterns": ["**/node_modules/**", "**/*.d.ts", ".claude-plugin/types/**", "tmp/**"],
  "jsPlugins": ["@jliocsar/begone-slop"],
  "rules": {
    "promise/prefer-await-to-then": "error",
    "id-length": [
      "error",
      {
        "min": 2,
        "exceptions": ["i", "j", "$"],
        "properties": "never"
      }
    ],
    "no-else-return": [
      "error",
      {
        "allowElseIf": false
      }
    ],
    "no-nested-ternary": "error",
    "prefer-template": "error",
    "complexity": ["error", 15],
    "max-lines-per-function": [
      "error",
      {
        "max": 200,
        "skipBlankLines": true,
        "skipComments": true,
        "IIFEs": true
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/array-type": [
      "error",
      {
        "default": "array",
        "readonly": "array"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowNumber": true,
        "allowBoolean": true
      }
    ],
    "begone-slop/no-comments": "off",
    "begone-slop/no-try-catch": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*_test.ts"],
      "rules": {
        "begone-slop/expect-padding": "error",
        "max-lines-per-function": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-confusing-void-expression": "off"
      }
    }
  ]
}
